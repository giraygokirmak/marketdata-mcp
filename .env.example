# =============================================================
# marketdata-mcp — Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below (everything is optional)
# 3. .env is in .gitignore — it will NEVER be committed to git
#
# No proxy configuration: both providers talk to their upstreams directly.
# =============================================================

# ── Server ───────────────────────────────────────────────────
# Only used by `marketdata-mcp streamable-http`; the Docker CMD already sets these.
HOST=0.0.0.0
PORT=8000

# ── Provider health / schema-drift monitor ───────────────────
# The monitor probes every upstream endpoint (finviz JSON islands + quote HTML,
# TradingView scanner, Yahoo chart API) and warns inside every tool response if
# a path, status code, JSON key or HTML marker changes.
MARKETDATA_HEALTH_ENABLED=true
# How often to re-probe, in seconds.
MARKETDATA_HEALTH_INTERVAL=300
# How long a cached verdict is reused before the next tool call re-probes.
MARKETDATA_HEALTH_TTL=60
# Per-probe timeout, in seconds.
MARKETDATA_HEALTH_TIMEOUT=12
# Where the schema baselines are stored, so drift is detected across restarts.
# Leave unset to use ~/.marketdata-mcp/health_state.json.
# MARKETDATA_HEALTH_STATE=/home/mcpuser/.marketdata-mcp/state/health_state.json

# ── Finviz (scraper tuning) ──────────────────────────────────
# Cache lifetime for scraped pages, in seconds. Shorter = fresher quotes.
FINVIZ_CACHE_TTL=30
# HTTP timeout for finviz.com, in seconds.
FINVIZ_TIMEOUT=25
# Retries on transient failures (Cloudflare interstitial, 5xx).
FINVIZ_MAX_RETRIES=2
# Where rendered chart PNGs are written.
# FINVIZ_CHART_DIR=/home/mcpuser/.marketdata-mcp/charts

# ── TradingView scanner (rate-limit tuning) ──────────────────
# Minimum spacing between scanner requests, in seconds.
TRADINGVIEW_MCP_MIN_INTERVAL_S=0.25
# Max concurrent scanner requests.
TRADINGVIEW_MCP_MAX_INFLIGHT=4
# Retry delays (comma-separated seconds) and jitter fraction.
TRADINGVIEW_MCP_RETRY_DELAYS=0.5,1.5,3.0
TRADINGVIEW_MCP_RETRY_JITTER=0.25

# ── News sentiment (optional — Marketaux) ────────────────────
# market_sentiment and combined_analysis use the licensed Marketaux API.
# Get a token at https://www.marketaux.com — without it those two tools
# report NOT_CONFIGURED and every other tool works normally.
MARKETAUX_API_TOKEN=
# Max Marketaux requests per day before serving cached/stub results.
MARKETAUX_DAILY_BUDGET=90
